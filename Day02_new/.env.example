# 이 파일을 .env 로 복사한 뒤 ANTHROPIC_API_KEY 에 본인의 키를 직접 채우세요. (cp .env.example .env)
# 키가 없으면 모델을 만드는 셀에서 바로 멈춥니다. 키 없이 도는 경로는 없습니다.
ANTHROPIC_API_KEY=
# 수업 기본 모델과 추론 깊이입니다.
DAY02_MODEL=claude-sonnet-5-5
DAY02_EFFORT=medium
# dense 검색에 쓰는 로컬 임베딩 모델입니다. 키가 필요 없고 첫 실행 때 파일을 내려받습니다.
DAY02_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# 판단(Decision) API 키입니다. 아래 셋(또는 Azure) 중 하나는 반드시 채워야 합니다. 비어 있으면 해당 셀에서 바로 멈춥니다.
# Claude로 대신하는 경로는 없습니다. 질문 문장과 근거 문서 내용이 고른 공급자에게 그대로 전송됩니다.
# 둘 이상 채우면 TYPESAFE, OPENROUTER, OPENAI, AZURE 순서의 첫 번째를 쓰고, DAY02_DECISION_BACKEND로 직접 고를 수 있습니다.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# typesafe, openrouter, openai, azure 중 하나. 비워 두면 위 순서대로 키가 있는 첫 번째를 씁니다.
DAY02_DECISION_BACKEND=
# Azure OpenAI Decisions (선택). 키가 있으면 아래 둘도 반드시 채워야 하며, 없으면 make_decider가 멈춥니다. 자동 순서에서는 맨 마지막입니다.
# 엔드포인트는 https://<리소스 이름>.openai.azure.com 형태이고, 배포 이름이 요청의 model로 갑니다. (East US 2는 출시 대상에서 제외, Entra ID 인증은 지원하지 않고 API 키만 씁니다.)
AZURE_OPENAI_API_KEY=
DAY02_AZURE_ENDPOINT=
DAY02_AZURE_DEPLOYMENT=
# OpenRouter가 보낼 모델 id를 바꿉니다. 비우면 코드의 고정값을 씁니다. 그 id는 미확인입니다(OpenRouter 모델 페이지가 2026-11-01에 404였음).
DAY02_OPENROUTER_MODEL=
# Python 실행기(run_pipeline.py)의 기본 모델 공급자 OpenGateway입니다(노트북 00~06에는 필요 없습니다).
# Anthropic Messages 호환 주소(https://apis.opengateway.ai)로 deepseek/deepseek-v4.1-flash-ultrafast를 부릅니다.
# 실행기를 Anthropic Claude로 돌리려면 이 키 대신 ANTHROPIC_API_KEY를 쓰게 --provider anthropic 을 넘깁니다.
OPENGATEWAY_API_KEY=
# 보조 실행기의 검색 구성(파일 시스템 설정). 노트북 00~06은 이 값을 읽지 않는다.
# bm25 로 두면 로컬 임베딩 모델(e5, 약 470MB)을 내려받지 않고 형태소 검색만 쓴다. 선택: bm25, dense, hybrid, fusion
DAY02_RETRIEVAL_MODE=fusion
# 재순위. on 은 로컬 교차 인코더(bge-reranker-v2-m3, 약 2.1GB), off 끔, jev 는 Decision API(Jev)가 후보별
# 관련 확률로 재순위한다(로컬 모델 없음, 판단 호출이 유료). 선택: on, off, jev
DAY02_RERANKER=on
