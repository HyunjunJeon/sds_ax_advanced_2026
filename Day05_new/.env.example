# Day05_new/.env.example 를 Day05_new/.env 로 복사한 뒤 본인의 값을 직접 채웁니다.
# .env 는 커밋하지 않습니다(.gitignore). 값을 로그나 결과 파일에 남기지 않습니다.

# --- 필수 ---
# Agent, Judge, 개선기(improver)가 쓰는 모델 공급자 키입니다. 모든 유료 셀에 필요합니다.
# 기본 공급자는 OpenGateway(https://apis.opengateway.ai, Anthropic Messages 호환)이고
# 기본 모델은 deepseek/deepseek-v4.1-flash-ultrafast 입니다.
OPENGATEWAY_API_KEY=

# --- 공급자 바꾸기 (선택) ---
# 비우면 opengateway. anthropic 으로 바꾸면 아래 ANTHROPIC_API_KEY 를 쓰고 기본 모델은 claude-sonnet-5-5 입니다.
DAY05_PROVIDER=
ANTHROPIC_API_KEY=

# --- Decision API 키 (Jev 판정용, 아래 중 하나 이상) ---
# 선택 규칙(eval_lab/decisions.py make_decider):
#   DAY05_DECISION_BACKEND 가 비어 있으면 TYPESAFE, OPENROUTER, OPENAI, AZURE 순서로
#   키가 채워진 첫 번째를 씁니다. DAY05_DECISION_BACKEND 에 typesafe, openrouter, openai, azure 중
#   하나를 적으면 그 백엔드만 보고, 그 키가 비어 있으면 멈춥니다. 에이전트 모델로 대신하지 않습니다.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Azure를 쓰면 키와 함께 아래 DAY05_AZURE_ENDPOINT, DAY05_AZURE_DEPLOYMENT 도 필요합니다.
AZURE_OPENAI_API_KEY=
DAY05_DECISION_BACKEND=
DAY05_AZURE_ENDPOINT=
DAY05_AZURE_DEPLOYMENT=

# --- Langfuse (Langfuse 셀에서만 필요) ---
# 비어 있으면 노트북은 로컬 경로로 진행합니다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 비우면 Langfuse 기본 호스트를 씁니다.
LANGFUSE_HOST=
# Langfuse 화면의 .env 예시가 주는 LANGFUSE_BASE_URL 줄을 그대로 붙여 넣어도 됩니다(LANGFUSE_HOST가 있으면 그쪽이 우선).
# 주소는 프로젝트를 만든 데이터 지역과 같아야 합니다(예: https://us.cloud.langfuse.com, https://jp.cloud.langfuse.com).
LANGFUSE_BASE_URL=
# 기본값: day05_new
LANGFUSE_TRACING_ENVIRONMENT=

# --- 선택 덮어쓰기 (비우면 기본값) ---
# Agent·개선기 모델. 기본값: 공급자 기본 모델(opengateway면 deepseek/deepseek-v4.1-flash-ultrafast)
DAY05_MODEL=
# Agent effort. 기본값: medium
DAY05_EFFORT=
# Judge 모델. 기본값: 공급자 기본 모델(opengateway면 deepseek/deepseek-v4.1-flash-ultrafast)
DAY05_JUDGE_MODEL=
# Judge effort. 기본값: xhigh
DAY05_JUDGE_EFFORT=
# 개선안 작성(improver) effort. 기본값: high
DAY05_IMPROVER_EFFORT=
