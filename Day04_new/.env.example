# Day04_new 환경 변수 예시. 이 파일을 .env로 복사한 뒤 수강생 본인이 키를 직접 채웁니다.
# 키 값을 채팅, 로그, 커밋에 남기지 마세요.

# Claude (Anthropic) 키와 모델
ANTHROPIC_API_KEY=
DAY04_MODEL=claude-sonnet-5-5
DAY04_EFFORT=medium

# Decision API: 아래 넷 중 하나만 채우면 됩니다 (TYPESAFE / OPENROUTER / OPENAI / AZURE).
# Decision API는 에이전트의 답변과 목표 문장을 공급자에게 그대로 전송합니다.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
DAY04_AZURE_ENDPOINT=
DAY04_AZURE_DEPLOYMENT=
DAY04_DECISION_BACKEND=typesafe

# Langfuse: 프롬프트와 도구의 입력/출력이 Langfuse로 전송됩니다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
LANGFUSE_TRACING_ENVIRONMENT=day04_new
