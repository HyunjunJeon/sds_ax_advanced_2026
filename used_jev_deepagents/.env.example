# Chat provider: anthropic (default) or openrouter
LLM_PROVIDER=anthropic

# Chat models when LLM_PROVIDER=anthropic (claude-haiku-5-5, effort medium)
ANTHROPIC_API_KEY=

# Chat models when LLM_PROVIDER=openrouter — langchain-openrouter reads this key only
OPENROUTER_API_KEY=

# Jev / TypeSafe System One — https://docs.typesafe.ai/introduction/quickstart
TYPESAFE_API_KEY=

# Live web retrieval (Exa). Optional; Jev skips web when this is empty.
EXA_API_KEY=

# Langfuse tracing + gold-suite experiments. Optional.
# Japan region: https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=demo
